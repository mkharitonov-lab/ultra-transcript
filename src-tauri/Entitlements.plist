<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Подписанное приложение работает в hardened runtime: без этого ключа macOS не спрашивает
       разрешения на микрофон и молча отдаёт тишину. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- NeMo-Speech.cpp (Nemotron 3) лежит в Frameworks с локальной подписью, без Team ID:
       без этого ключа hardened runtime не даёт её загрузить. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
