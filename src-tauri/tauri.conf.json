{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ультра Транскрибатор",
  "version": "0.2.1",
  "identifier": "app.ultratranscript",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ультра Транскрибатор",
        "width": 1240,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/recordings/**",
          "$APPDATA/voices/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/ffmpeg"
    ],
    "macOS": {
      "minimumSystemVersion": "14.2",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYzQUY5RjBDMkI0NkM4ODIKUldTQ3lFWXJESit2WThXcEhVWVMzZXJzbWpzbU9CQitOVUVTbVZ4SnRsN0ZBT2l2MmhXTzg0VWgK",
      "endpoints": [
        "https://github.com/mkharitonov-lab/ultra-transcript/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
