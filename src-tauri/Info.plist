<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Языки интерфейса: по ним система выбирает язык своих диалогов (выбор файла, уведомления). -->
  <key>CFBundleDevelopmentRegion</key>
  <string>ru</string>
  <key>CFBundleLocalizations</key>
  <array>
    <string>ru</string>
    <string>en</string>
  </array>
  <!-- Запись с микрофона: без этой строки система не спросит разрешения и звука не будет. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Для записи встреч и диктовок с расшифровкой на ходу · To record meetings and dictation with live transcription</string>
  <!-- Запись видеовстреч: звук компьютера через Core Audio process tap (macOS 14.4+). -->
  <key>NSAudioCaptureUsageDescription</key>
  <string>Для записи видеовстреч: голоса собеседников из Zoom, Телемоста, браузера · To record video calls: the other side's voices from Zoom, Teams, the browser</string>
</dict>
</plist>
